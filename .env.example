# AI Decal Studio — image generation
# Copy file này thành `.env` và điền key thật. KHÔNG commit file `.env`.
# ⚠️ KHÔNG dán key thật vào file .env.example này — nó được commit lên GitHub.

# Chọn provider: "openai" (mặc định) | "gemini" | "fal"
IMAGE_PROVIDER=openai

# OpenAI gpt-image-1 — https://platform.openai.com/api-keys (cần verify tổ chức)
OPENAI_API_KEY=sk-...

# Google Gemini 2.5 Flash Image ("Nano Banana") — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# FLUX.1 Kontext (Black Forest Labs) qua fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=
